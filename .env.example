# --- CONFIGURACIÓN DE DJANGO ---
# Genera una clave nueva para producción. No uses la de este ejemplo.
SECRET_KEY=tu-clave-secreta-aqui

# Cambia a False cuando subas el proyecto a un servidor real
DEBUG=True

# Hosts permitidos, separados por comas (déjalo vacío en desarrollo)
ALLOWED_HOSTS=

# --- CONFIGURACIÓN DE BASE DE DATOS (Opcional si usas SQLite) ---
# Si en el futuro usas Postgres/MySQL, añade las variables aquí
# DB_NAME=tu_db
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password
